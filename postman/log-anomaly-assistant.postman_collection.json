{
  "info": {
    "_postman_id": "d3b7a80f-5523-4ba8-8559-98230d58ecfd",
    "name": "Log Anomaly Assistant",
    "description": "Import the accompanying Local environment, select it, start the application, then run these requests. No API key belongs in Postman; OPENAI_API_KEY is read by the server process.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get service statistics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('returns a statistics array', () => pm.expect(Array.isArray(pm.response.json())).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/stats",
        "description": "Per-service request count, 5xx rate, p95 latency, and UTC hourly distribution."
      },
      "response": []
    },
    {
      "name": "Get detected anomalies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('returns an anomaly array', () => pm.expect(Array.isArray(pm.response.json())).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/anomalies",
        "description": "Evidence-backed deterministic anomalies from the supplied log file."
      },
      "response": []
    },
    {
      "name": "Ask - suspicious login activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('returns a non-empty answer', () => pm.expect(pm.response.json().answer).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Şüpheli login aktivitesi var mı?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/ask",
        "description": "Demonstrates the authentication-burst evidence path."
      },
      "response": []
    },
